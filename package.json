{
  "name": "@evagentic/recorder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "docs/capture-v1.md",
    "docs/pilot-verification.md",
    "scripts/inspect.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && npm run build:webapp",
    "build:webapp": "vite build webapp/client -c webapp/client/vite.config.ts",
    "dev:webapp": "vite webapp/client -c webapp/client/vite.config.ts",
    "prepack": "npm run build",
    "lint": "npm run lint:comments",
    "lint:comments": "node scripts/lint-comments.mjs",
    "lint:comments:ratchet": "node scripts/lint-comments.mjs --ratchet",
    "comments:inventory": "node scripts/lint-comments.mjs --inventory",
    "typecheck": "tsc --noEmit && tsc -p webapp/client --noEmit",
    "verify:pilot": "npm run build && node --test --test-concurrency=1 test/pilot.test.mjs",
    "test": "npm run lint && npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "webapp": "node webapp/server.mjs"
  },
  "dependencies": {
    "@opencode/plugin": "2.1.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.0.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "lucide-react": "^1.82.0",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.0",
    "vite": "^8.4.0"
  }
}
